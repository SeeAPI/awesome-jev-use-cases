{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jev case record",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "category",
    "task",
    "input_type",
    "jev_primitive",
    "software_action",
    "source_url",
    "evidence",
    "limitations",
    "tags",
    "recipe_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "required": [
        "en",
        "zh"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "en",
        "zh"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "enum": [
        "moderation",
        "automation",
        "routing",
        "search",
        "productivity",
        "experiments",
        "benchmarks"
      ]
    },
    "task": {
      "enum": [
        "decision",
        "ranking",
        "evaluation"
      ]
    },
    "input_type": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jev_primitive": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "choice",
          "noul",
          "score"
        ]
      }
    },
    "software_action": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "evidence": {
      "type": "object",
      "required": [
        "level",
        "verified_by_seeapi",
        "reviewed_at",
        "sources",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "source-reviewed",
            "docs-reviewed",
            "author-demo",
            "seeapi-tested",
            "independently-benchmarked"
          ]
        },
        "verified_by_seeapi": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "dataset_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "object",
      "required": [
        "en",
        "zh"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "zh": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recipe_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "model-routing"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "level": {
                "const": "seeapi-tested"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "required": [
              "report_path"
            ],
            "properties": {
              "verified_by_seeapi": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "level": {
                "const": "independently-benchmarked"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "required": [
              "report_path",
              "dataset_path"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "level": {
                "enum": [
                  "source-reviewed",
                  "docs-reviewed",
                  "author-demo"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "verified_by_seeapi": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
